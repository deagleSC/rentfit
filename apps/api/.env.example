APP_ENV=dev
# Local: rentfit_api on the local Supabase DB (port 54322). Production: Supavisor transaction-mode
# URL (port 6543), user rentfit_api.<project-ref>
DATABASE_URL=postgresql://rentfit_api:dev@localhost:54322/postgres
DATABASE_URL_JOBS=postgresql://rentfit_jobs:dev@localhost:54322/postgres
# Tests only: owner connection (user postgres, session pooler port 5432) used by tests/db.
# Every test runs in a transaction that is rolled back; nothing is committed.
TEST_ADMIN_DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# CORS_ORIGIN_REGEX=^https://rentfit-(landlord|tenant)-[a-z0-9-]+\.vercel\.app$

# Storage (private bucket for listing photos). Service key only for signed URLs.
SUPABASE_SERVICE_KEY=
PHOTO_BUCKET=listing-photos

# Jobs: inline in dev/test, inngest in production.
JOB_DISPATCHER=inline
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Embeddings Edge Function. Unset: hashing embedder.
EMBED_FUNCTION_URL=
EMBED_FUNCTION_KEY=

# LLM: fake in dev; openrouter for real runs.
LLM_PROVIDER=fake
OPENROUTER_API_KEY=
# LLM_STRUCTURED_MODELS=["google/gemma-4-26b-a4b-it","google/gemma-4-31b-it"]
# LLM_CHAT_MODELS=["google/gemma-4-26b-a4b-it","google/gemma-4-31b-it"]
LLM_DAILY_CAP=300
LLM_RPM_CAP=20
LLM_SYNC_RPM_CAP=10

# Commute. Unset: haversine estimate.
ORS_API_KEY=

# Tracing and errors (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
